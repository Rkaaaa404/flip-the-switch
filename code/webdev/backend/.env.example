APP_NAME=NusaQC Backend
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database
DATABASE_URL=sqlite:///./nusaqc.db

# Flags & Paths
ENABLE_MOCK_HARDWARE=true
MODEL_DIR=./models_weights
UPLOAD_DIR=./uploads

# Switch room integration (generate with: python -c "import secrets; print(secrets.token_urlsafe(24))")
# qc-agent can read and draft; only qc-gate can write dispositions and movements. Empty = refuse all.
QC_AGENT_TOKEN=
QC_GATE_TOKEN=
